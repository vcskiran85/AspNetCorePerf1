@page "/HighMemoryNative"
@model NativeMemoryModel
@{
    ViewData["Title"] = "Native memory";
}
@if (Model.Outcome is string outcome)
{
    <p class="outcome" role="status">@outcome</p>
}
<p>Allocate and touch 500,000,000 bytes outside the managed heap. Compare private bytes or working set with the managed-heap counters.</p>
<p>Managed and native allocations share a 10,000,000,000-byte cap. Memory is released with Stop or after two minutes of memory inactivity.</p>
<form method="post" asp-page="/NativeMemory"><button type="submit">Add 500,000,000 native bytes</button></form>
